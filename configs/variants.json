          "impl": "time_decay",
          "params": {
            "lambda": 0.005,
            "unit": "day",
            "except_history": true
          }
        },
        "compress": {
          "impl": "extractive",
          "params": {
            "budget_tokens": 4000
          }
        },
        "filter": {
          "impl": "threshold",
          "params": {
            "min_relevance": 0.2,
            "drop_stale": true,
            "drop_conflicting": false
          }
        }
      },
      "temporal": {
        "model": "bitemporal",
        "params": {
          "as_of": "query_time",
          "conflict_policy": "invalidate_edge",
          "precision": "day"
        }
      },
      "logic": {
        "state_resolver": "query_llm",
        "audit": "adversarial",
