  "id": "E1.2-E1.3-variant-parameter-and-llm-screening",
  "title": "Module-internal variant, parameter and module-LLM screening",
  "design": "single_factor_variant_and_parameter",
  "reference_config": "../../configs/reference-r0.json",
  "hypotheses": [
    "H1",
    "H2",
    "H3",
    "H4",
    "H5",
    "H7"
  ],
  "environment": {
    "llm_level": "L2",
    "llm": "qwen3.8:27b-q4_K_M",
    "data_scale": "S2",
    "scene": "personal_assistant",
    "context_budget": 32768,
    "query_mix": "balanced",
    "seed": 13
  },
  "dataset": {
    "adapter": "locomo",
    "split": "development",
    "samples": [
      "conv-26",
      "conv-30",
      "conv-43",
      "conv-44"
    ],
    "question_limit": 120,
    "stratify": "category",
    "repeat": 2
  },
  "protocol": {
    "paired": true,
    "same_questions_across_configs": true,
    "fixed_candidate_budget": 15,
    "tier_order": [
      "tier0",
      "tier1"
    ],
    "stop_rules": {
      "max_error_rate": 0.05,
      "min_completed_questions": 100,
      "abort_on_context_overflow_rate": 0.2
    },
    "derived_rules": [
      {
        "when": {
          "schema.impl": [
            "legacy_flat",
            "hmem",
            "structmem",
            "amem"
          ]
        },
        "set": {
          "schema.params.bitemporal": false,
          "temporal.model": "version_chain",
          "temporal.params.conflict_policy": "keep_both",
          "logic.state_resolver": "query_llm"
        },
        "reason": "Only meta_schema emits bi-temporal fields in the first implementation; other schemas collapse to record time."
      },
      {
        "when": {
          "graph.repr.impl": "none"
        },
        "set": {
          "graph.retrieval.impl": "vector_only"
        },
        "reason": "No graph index to retrieve from."
      },
      {
        "when": {
          "schema.params.bitemporal": false
        },
        "set": {
          "temporal.model": "version_chain",
          "temporal.params.conflict_policy": "keep_both",
          "logic.state_resolver": "query_llm"
        },
        "reason": "Bi-temporal query and edge invalidation require bi-temporal fields."
      },
      {
        "when": {
          "temporal.model": "record_time"
        },
        "set": {
          "temporal.params.conflict_policy": "keep_both",
          "logic.state_resolver": "query_llm"
        },
        "reason": "Record-time model has no validity intervals; fall back to keep_both."
      },
      {
        "when": {
          "planner.impl": "none"
        },
        "set": {
          "planner.params.granularity": "coarse",
          "planner.params.parallelism": 1
        },
        "reason": "Granularity/parallelism have no effect without a planner."
      },
      {
        "when": {
          "post.mmr.impl": "none"
        },
        "set": {
          "post.mmr.params.lambda": 0.7
        },
        "reason": "MMR lambda has no effect when MMR is off."
      },
      {
        "when": {
          "post.decay.impl": "none"
        },
        "set": {
          "post.decay.params.lambda": 0.0
        },
        "reason": "Decay lambda has no effect when decay is off."
      }
    ],
    "dependency_closure": true,
    "note": "Apply derived_rules in order after overriding one factor; record the effective config and config_hash. Factors with applies_when are skipped when the condition does not hold."
  },
