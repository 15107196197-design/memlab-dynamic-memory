{
  "schema": "memlab/experiment@1",
  "id": "E2-module-coupling",
  "title": "E2 module coupling: quality propagation, oracle gaps and LLM attribution",
  "design": "coupling_analysis",
  "reference_config": "../../configs/reference-r0.json",
  "inputs": {
    "s6_candidates": "HANDOFF §5 / runs/e1",
    "s6_metrics": "runs/e1/*.sqlite",
    "oracle_runs": "runs/e2/oracle-*.sqlite"
  },
  "gates": [
    "evidence_recall",
    "context_precision",
    "state_accuracy"
  ],
  "oracles": [
    "retrieval",
    "merge",
    "state",
    "answer"
  ],
  "metrics": [
    "answer_f1",
    "evidence_recall",
    "context_precision",
    "state_accuracy",
    "tokens",
    "latency_ms"
  ],
  "protocol": {
    "paired": true,
    "gate_min": 1.0,
    "outcome_min": 0.0,
    "note": "S7a builds the analysis; S7b runs only after S6 candidates exist. Oracle runs are separate SQLite databases produced by the S6/S7 runner."
  }
}
