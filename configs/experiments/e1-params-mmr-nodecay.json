{
  "schema": "memlab/experiment@1",
  "id": "E1.2-MMR-lambda-nodecay",
  "title": "M4 MMR lambda with decay disabled (isolated MMR order)",
  "module": "M4",
  "design": "single_factor",
  "reference_config": "../../configs/reference-r0-nodecay.json",
  "environment": {
    "llm_level": "A0",
    "llm": "offline-extractive",
    "embedding": "offline-hash",
    "data_scale": "S2",
    "scene": "personal_assistant",
    "context_budget": 32768,
    "query_mix": "balanced",
    "seed": 13
  },
  "dataset": {
    "adapter": "locomo",
    "split": "development",
    "samples": [
      "conv-26",
      "conv-30",
      "conv-43",
      "conv-44"
    ],
    "question_limit": 60,
    "stratify": "category"
  },
  "protocol": {
    "paired": true,
    "same_questions_across_configs": true,
    "fixed_candidate_budget": 15,
    "note": "MMR x decay order interaction is NOT tested; decay is fixed off so MMR is the last reordering stage before compress."
  },
  "factors": [
    {
      "id": "post.mmr.params.lambda",
      "module": "M4",
      "axis": "post.mmr",
      "levels": [
        0.5,
        0.7,
        0.9
      ],
      "hypothesis": "H2",
      "metrics": [
        "redundancy_rate",
        "recall@15",
        "ndcg@15",
        "tokens_per_query"
      ],
      "applies_when": {
        "post.mmr.impl": "mmr"
      }
    }
  ],
  "metrics": [
    "recall@15",
    "ndcg@15",
    "redundancy_rate",
    "tokens_per_query",
    "error_rate"
  ],
  "budget": {
    "max_configs": 3,
    "max_questions_per_config": 60,
    "max_gpu_hours": 0,
    "max_api_usd": 0
  },
  "output": {
    "runs_dir": "runs/params",
    "report": "eval/archive/params-mmr-lambda-nodecay.json"
  }
}
