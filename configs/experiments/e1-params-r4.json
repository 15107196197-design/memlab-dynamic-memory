{
  "schema": "memlab/experiment@1",
  "id": "E1.2-R4-k-corrected",
  "title": "R4 retrieval.k correction after wiring the e2e executor",
  "module": "R4",
  "design": "single_factor",
  "reference_config": "../../configs/reference-r0.json",
  "environment": {
    "llm_level": "A0",
    "llm": "offline-extractive",
    "embedding": "offline-hash",
    "data_scale": "S2",
    "scene": "personal_assistant",
    "context_budget": 32768,
    "query_mix": "balanced",
    "seed": 13
  },
  "dataset": {
    "adapter": "locomo",
    "split": "development",
    "samples": ["conv-26", "conv-30", "conv-43", "conv-44"],
    "question_limit": 60,
    "stratify": "category"
  },
  "protocol": {
    "paired": true,
    "same_questions_across_configs": true,
    "fixed_candidate_budget": 15,
    "note": "executor.retrieval_k now reads plan.effective_config['retrieval']['k']; 10/15/25 must change the candidate budget."
  },
  "factors": [
    {
      "id": "retrieval.k",
      "module": "R4",
      "axis": "retrieval",
      "levels": [10, 15, 25],
      "hypothesis": "H4",
      "metrics": ["recall@15", "ndcg@15", "tokens_per_query", "candidates"]
    }
  ],
  "metrics": ["recall@15", "ndcg@15", "tokens_per_query", "error_rate"],
  "budget": {"max_configs": 3, "max_questions_per_config": 60, "max_gpu_hours": 0, "max_api_usd": 0},
  "output": {"runs_dir": "runs/params", "report": "eval/archive/params-planner-k-corrected.json"}
}
