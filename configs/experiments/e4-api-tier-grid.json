{
  "schema": "memlab/experiment@1",
  "id": "E4-api-tier-grid",
  "title": "API-tier environment grid: provider/capability tier x data scale x scene",
  "design": "environment_grid",
  "reference_config": "../../configs/reference-r0.json",
  "hypotheses": [
    "H8",
    "H9-api",
    "H10"
  ],
  "grid": {
    "llm": [
      {
        "id": "API_T1_cheap",
        "provider": "openai_compatible",
        "model": "Qwen/Qwen2.5-7B-Instruct",
        "base_url": "https://api.siliconflow.cn/v1",
        "api_key_env": "SILICONFLOW_API_KEY",
        "level": "tier1_cheap"
      },
      {
        "id": "API_T2_mid",
        "provider": "openai_compatible",
        "model": "Qwen/Qwen2.5-32B-Instruct",
        "base_url": "https://api.siliconflow.cn/v1",
        "api_key_env": "SILICONFLOW_API_KEY",
        "level": "tier2_mid"
      },
      {
        "id": "API_T3_strong",
        "provider": "openai_compatible",
        "model": "Qwen/Qwen2.5-72B-Instruct",
        "base_url": "https://api.siliconflow.cn/v1",
        "api_key_env": "SILICONFLOW_API_KEY",
        "level": "tier3_strong"
      }
    ],
    "data_scale": [
      {
        "id": "S1_test2",
        "samples": [
          "conv-41",
          "conv-42"
        ],
        "question_limit": 351,
        "approx_tokens": 45000
      },
      {
        "id": "S2_course6",
        "samples": [
          "conv-26",
          "conv-30",
          "conv-41",
          "conv-42",
          "conv-43",
          "conv-44"
        ],
        "question_limit": 885,
        "approx_tokens": 130000
      },
      {
        "id": "S3_locomo10",
        "samples": [
          "conv-26",
          "conv-30",
          "conv-41",
          "conv-42",
          "conv-43",
          "conv-44",
          "conv-47",
          "conv-48",
          "conv-49",
          "conv-50"
        ],
        "question_limit": 1540,
        "approx_tokens": 215000
      }
    ],
    "scene": [
      {
        "id": "personal_assistant",
        "adapter": "locomo",
        "status": "ready"
      }
    ]
  },
  "candidates": [
    {
      "id": "B0",
      "config": "B0_legacy",
      "role": "control"
    },
    {
      "id": "R0",
      "config": "R0_reference",
      "role": "reference"
    },
    {
      "id": "CHEAP",
      "config": "R0_cheap",
      "role": "low_cost"
    },
    {
      "id": "QUALITY",
      "config": "R0_quality",
      "role": "high_cost"
    }
  ],
  "deferred": [
    {
      "id": "local_llm_scale",
      "levels": [
        "L1_7b",
        "L2_27b",
        "L3_72b"
      ],
      "status": "blocked_on_local_gpu",
      "reason": "No usable local GPU (Intel Arc integrated/shared memory, Windows). Local 27B/72B cannot be run at experiment scale. The original design and evaluation protocol are retained in 04-experiments; this API-tier grid replaces the executable axis, not the research question.",
      "planned_in": "future machine with >=24GB VRAM or remote GPU endpoint"
    },
    {
      "id": "scene",
      "levels": [
        "coding",
        "customer_service"
      ],
      "status": "deferred_blocked_on_scene_adapter",
      "reason": "Scene adapters are planned, not implemented; do not count them as empty cells."
    },
    {
      "id": "candidate",
      "levels": [
        "E3_WINNER"
      ],
      "status": "deferred_blocked_on_E3",
      "reason": "The interaction winner is defined by E3; it returns after E3 selects a winner."
    }
  ],
  "protocol": {
    "minimum_cells": 9,
    "full_cells": 36,
    "questions_per_cell_screening": 60,
    "questions_per_cell_confirmation": 120,
    "fixed": {
      "context_budget": 32768,
      "query_mix": "balanced",
      "seed": 13,
      "candidate_budget": 15
    },
    "tier_semantics": "API_T1/T2/T3 are provider capability tiers, not parameter counts. Never label them 7B/27B/72B."
  },
  "selection": {
    "objective": "maximize judge_accuracy subject to tokens_per_query <= 8000 and p95_latency_ms <= 60000",
    "fallback_objective": "maximize 0.6 * normalized_f1 + 0.3 * normalized_state_accuracy + 0.1 * normalized_recall_at_15",
    "report": [
      "per_cell_best",
      "global_best",
      "regret",
      "conditional_gain",
      "pareto_front",
      "strategy_table",
      "config_x_api_tier_interaction"
    ]
  },
  "metrics": [
    "answer_f1",
    "judge_accuracy",
    "state_accuracy",
    "as_of_accuracy",
    "recall@15",
    "ndcg@15",
    "tokens_per_query",
    "p50_latency_ms",
    "p95_latency_ms",
    "error_rate",
    "api_cost_usd"
  ],
  "analysis": {
    "model": "mixed_effects",
    "formula": "metric ~ config * api_tier * scale * scene + (1|question)",
    "interaction_test": "likelihood_ratio",
    "cluster_by": "conversation",
    "bootstrap_samples": 1000,
    "correction": "holm"
  },
  "budget": {
    "max_cells": 36,
    "max_configs_per_cell": 5,
    "max_api_usd": 500
  },
  "output": {
    "runs_dir": "runs/e4-api",
    "report": "reports/e4-api-tier.html"
  },
  "reference_configs": {
    "off": "../../configs/reference-b0.json",
    "on": "../../configs/reference-r0.json",
    "cheap": "../../configs/reference-cheap.json",
    "quality": "../../configs/reference-quality.json"
  },
  "environment": {
    "embedding": {
      "provider": "openai_compatible",
      "model": "BAAI/bge-m3",
      "base_url": "https://api.siliconflow.cn/v1",
      "api_key_env": "SILICONFLOW_API_KEY"
    }
  }
}
